{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTally",
  "version": "0.1.0",
  "identifier": "org.opentally.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": null,
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTally — Modern Accounting Foundation",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}

